# KIS OpenAPI (모의투자) — 실제 값은 .env에만 작성하고 커밋하지 말 것
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_ENV=vps
# 체결통보 WS 구독 키 (선물옵션 실시간체결통보 H0IFCNI9의 tr_key = HTS ID).
# 비어 있으면 체결통보를 구독하지 않는다 — 주문은 나가지만 체결 알림이 안 온다.
KIS_HTS_ID=

# TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mahdi
DB_USER=mahdi
DB_PASSWORD=mahdi

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Slack 알림 (2026-07-19, 운영점검보고서 §5-4) — 실제 값은 .env에만 작성하고 커밋하지 말 것
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_ALERTS_ENABLED_DEFAULT=true
